DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SAMBANOVA_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TAVILY_API_KEY=

# --- Projects: GitHub import / push ---
# Create an OAuth app at https://github.com/settings/developers and set the
# callback URL to https://<your-domain>/api/github/oauth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Project secrets (Secrets environment) ---
# 32 bytes, base64 or 64-char hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without this, the Secrets panel says so and refuses to store anything
# rather than writing values in plaintext.
ENCRYPTION_KEY=

# --- Staff access ---
# OWNER_EMAIL: the single account with full authority over the control panel
#   (/kore/admin). Matched case-insensitively against your Supabase login email.
# ADMIN_EMAILS: comma-separated additional staff emails, granted the "admin"
#   role. Everyone else is an ordinary user with no panel access.
OWNER_EMAIL=
ADMIN_EMAILS=
# --- Staff / hidden control panel ---
# The first owner cannot be created from inside the app, so declare it here.
# Any signed-in account whose email matches becomes owner (full authority) and
# can open the unlisted control panel at /kore/admin. Comma-separate several.
# Nothing about this appears in the UI for any other account.
OWNER_EMAIL=

# Also accepted: OWNER_EMAILS=a@x.com,b@x.com (same effect, more than one).
OWNER_EMAILS=

# --- Admin panel password auth ---
# Optional: a separate username/password for the unlisted /kore/admin panel,
# independent of Supabase accounts. Useful when you do not want to use your
# personal email as the owner.
# 1. Set ADMIN_USERNAME to the username (e.g. "2488711616").
# 2. Generate the password hash:
#      node -e "const crypto=require('crypto');const s='zerokore-admin-v1';const p=process.env.ADMIN_PASSWORD||'YOUR_PASSWORD';console.log(crypto.createHash('sha256').update(s+p).digest('hex'))"
# 3. Paste the output into ADMIN_PASSWORD_HASH.
# The password is hashed and never stored in plaintext. The hashed value is
# verified on every login attempt server-side.
ADMIN_USERNAME=2488711616
ADMIN_PASSWORD_HASH=
# A separate signing secret for the admin session cookie. Any random string is
# fine; change it if you want to invalidate all active admin password sessions.
ADMIN_SECRET=zerokore-admin-secret-change-me
